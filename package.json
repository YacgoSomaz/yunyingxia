{
  "name": "yunyingxia",
  "version": "0.1.33",
  "private": true,
  "description": "运营虾 - 本地优先的 AI 自媒体运营工作台",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "\".runtime-electron\\node_modules\\electron\\dist\\electron.exe\" .",
    "build": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json && vite build",
    "start": "\".runtime-electron\\node_modules\\electron\\dist\\electron.exe\" .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan:dropdowns": "node scripts/scan-dropdowns.cjs",
    "package:release": "pwsh -NoProfile -File packaging\\build\\build_release.ps1",
    "package:yunyingxia": "pwsh -NoProfile -File packaging\\build\\build_yunyingxia_release.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "javascript-obfuscator": "^5.5.0",
    "rcedit": "^5.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.2"
  }
}
